# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8080,https://id-preview--c5d5a97a-f514-4c0a-bc39-9ec743170dc8.lovable.app

# ---- MongoDB Atlas ----
# Replace <user>, <password>, <cluster> with your Atlas values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/haemocentral?retryWrites=true&w=majority
MONGODB_DB_NAME=haemocentral

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=5

# ---- Seeding ----
SEED_DEFAULT_PASSWORD=Password123!
